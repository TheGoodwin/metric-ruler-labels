<div class="waypoint-label {{cssClass}}">
    <div>
        {{#if action.icon}}
        <i class="icon {{action.icon}}"></i>
        {{else if action.label}}
        <label class="action-label">{{localize action.label}}</label>
        {{/if}}
        {{#if cost}}
        <span class="total-measurement">{{cost.total}} {{cost.units}}</span>
        {{#if cost.delta}}
        <span class="delta-measurement">({{cost.delta}})</span>
        {{/if}}
        {{else}}
        <span class="total-measurement">{{distance.total}} {{units}}</span>
        {{#if distance.delta}}
        <span class="delta-measurement">({{distance.delta}})</span>
        {{/if}}
        {{/if}}
        {{#if (and elevation (not elevation.hidden))}}
        <i class="icon {{elevation.icon}}"></i>
        <span class="total-elevation">{{elevation.total}} {{units}}</span>
        {{#if elevation.delta}}
        <span class="delta-elevation">({{elevation.delta}})</span>
        {{/if}}
        {{/if}}
        {{#if secret}}
        <i class="icon fa-solid fa-eye-slash"></i>
        {{/if}}
        <br />
        {{#if converted}}
        {{#if action.icon}}
        <i class="icon {{action.icon}}"></i>
        {{else if action.label}}
        <label class="action-label">{{localize action.label}}</label>
        {{/if}}
        {{#if cost}}
        <span class="total-measurement">{{converted.cost.total}} {{converted.cost.units}}</span>
        {{#if cost.delta}}
        <span class="delta-measurement">({{converted.cost.delta}})</span>
        {{/if}}
        {{else}}
        <span class="total-measurement">{{converted.distance.total}} {{converted.units}}</span>
        {{#if distance.delta}}
        <span class="delta-measurement">({{converted.distance.delta}})</span>
        {{/if}}
        {{/if}}
        {{#if (and elevation (not elevation.hidden))}}
        <i class="icon {{elevation.icon}}"></i>
        <span class="total-elevation">{{converted.elevation.total}} {{converted.units}}</span>
        {{#if elevation.delta}}
        <span class="delta-elevation">({{converted.elevation.delta}})</span>
        {{/if}}
        {{/if}}
        {{#if secret}}
        <i class="icon fa-solid fa-eye-slash"></i>
        {{/if}}
        {{/if}}
    </div>
</div>